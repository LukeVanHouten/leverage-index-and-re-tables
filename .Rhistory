for (i in 2015:2016) {
player_df <- leverage_index_df %>%
filter(game_year == i) %>%
select(pitcher, batter) %>%
melt() %>%
select(-variable) %>%
distinct(value) %>%
arrange(value)
li_vals <- t(sapply(player_df$value, function(x) {
compare_li(year = i, player = x)})) %>%
as.data.frame() %>%
cbind(player_df, .)
print(li_vals)
}
